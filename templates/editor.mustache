{{!
    @template assignsubmission_onlyoffice/editor

    Displays ONLYOFFICE instance content

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * containerid - Identifier of the editor container
    * editorid - Identifier of the element replaced by the editor

    Example context (json):
    {
        "containerid": "app-onlyoffice",
        "editorid": "onlyoffice-editor"
    }

}}
<div id="{{containerid}}" class="assignsubmission-onlyoffice-app">
    <div id="{{editorid}}"></div>
</div>
